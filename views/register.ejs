<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up – ProToolNest Privacy</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <div class="max-w-md mx-auto mt-20 bg-white border rounded-xl p-8">
    <a href="/" class="flex items-center gap-2 mb-6">
      <img src="/images/logo.png" alt="" class="h-8">
      <span class="font-semibold">ProToolNest Privacy</span>
    </a>
    <h1 class="text-2xl font-bold mb-6">Sign Up</h1>
    <% if (error) { %><p class="text-red-600 text-sm mb-4"><%= error %></p><% } %>
    <form method="POST" action="/register" class="space-y-4">
      <input name="email" type="email" placeholder="Email" required class="w-full border rounded px-3 py-2">
      <input name="password" type="password" placeholder="Password" required class="w-full border rounded px-3 py-2">
      <button class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">Create Account</button>
    </form>
    <p class="text-sm text-gray-600 mt-4">Already have an account? <a href="/login" class="text-blue-600">Login</a></p>
  </div>
</body>
</html>
